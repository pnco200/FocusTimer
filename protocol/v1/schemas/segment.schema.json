{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focus-timer.invalid/protocol/v1/schemas/segment.schema.json",
  "title": "Focus Timer immutable segment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "datasetId", "deviceId", "segmentId", "operations"],
  "properties": {
    "protocolVersion": { "type": "integer", "const": 1 },
    "datasetId": { "$ref": "focus-session.schema.json#/$defs/uuid" },
    "deviceId": { "$ref": "focus-session.schema.json#/$defs/uuid" },
    "segmentId": { "$ref": "focus-session.schema.json#/$defs/uuid" },
    "operations": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "operation.schema.json" } }
  },
  "$comment": "Additionally enforce raw UTF-8 <=1048576 bytes, max container depth 16, unique opId, and operation protocolVersion/datasetId/deviceId equality with envelope. uniqueItems cannot express identity uniqueness."
}
