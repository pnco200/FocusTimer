{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focus-timer.invalid/protocol/v1/schemas/focus-session.schema.json",
  "title": "FocusSession v1 (parsed shape; strict wire checks also required)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "startedAt", "endedAt", "focusDurationMs", "description"],
  "properties": {
    "id": { "$ref": "#/$defs/uuid" },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "endedAt": { "$ref": "#/$defs/timestamp" },
    "focusDurationMs": { "type": "integer", "minimum": 1, "maximum": 3155760000000 },
    "description": { "type": "string", "maxLength": 120 }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "$comment": "Additionally reject year 0000 and invalid Gregorian month/day combinations. No startedAt<=endedAt requirement."
    }
  },
  "$comment": "See ../protocol.md for strict numeric token spelling, UTF-8/scalar, duplicate-name, depth, resource and cross-field rules beyond JSON Schema."
}
